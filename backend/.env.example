# ==========================================
# TalentForge Backend - Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ==========================================

# --- Server ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# --- Database (MongoDB Atlas in production, local Mongo in dev) ---
MONGO_URI=mongodb://127.0.0.1:27017/talentforge

# --- JWT Auth ---
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d
JWT_COOKIE_NAME=tf_refresh_token

# --- Password Reset / Email Verification Tokens ---
RESET_PASSWORD_TOKEN_EXPIRES_MIN=30
EMAIL_VERIFICATION_TOKEN_EXPIRES_HOURS=24

# --- bcrypt ---
BCRYPT_SALT_ROUNDS=12

# --- Cloudinary (file storage) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_RESUME_FOLDER=talentforge/resumes
CLOUDINARY_LOGO_FOLDER=talentforge/company-logos
CLOUDINARY_PROFILE_PHOTO_FOLDER=talentforge/profile-photos

# --- Email (Nodemailer / SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="TalentForge <no-reply@talentforge.com>"

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=100

# --- Logging ---
LOG_LEVEL=info

# --- AI Features (Phase 10) ---
# Requires a Google Gemini API key: https://aistudio.google.com/app/apikey
# AI features degrade gracefully (503 with a clear message) if unset -
# the rest of the app runs fine without this.
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_MAX_TOKENS=2048
AI_RATE_LIMIT_WINDOW_MIN=60
AI_RATE_LIMIT_MAX_REQUESTS=20
